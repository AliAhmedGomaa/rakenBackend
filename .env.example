# MongoDB (required in production — set in Vercel/host env vars, not only .env locally)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE_NAME

# Auth (required in production)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Admin dashboard login (seeded on startup)
ADMIN_EMAIL=admin@raken.app
ADMIN_PASSWORD=replace_with_a_secure_admin_password
ADMIN_NAME=Raken Admin

# Public scan page (Angular). Origin only — /c/<stickerCode> is appended automatically.
PUBLIC_QR_BASE_URL=https://raken-web.vercel.app

PORT=3000

# Global route prefix for all controllers (default: api → /api/auth, /api/cars, …)
API_GLOBAL_PREFIX=api

# Optional — batch-generate via curl without admin JWT (header x-admin-key)
# ADMIN_API_KEY=replace_with_a_long_random_secret


# CORS — comma-separated origins when locking down prod (omit for dev-friendly allow-all with reflection)
# CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:5173,https://raken-web.vercel.app
# CORS_CREDENTIALS=false

# --- Production (Vercel / Railway / etc.) ---
# Copy every variable above into your host's Environment Variables UI.
# Minimum required: MONGODB_URI, JWT_SECRET
# MongoDB Atlas → Network Access → allow 0.0.0.0/0 (required for Vercel serverless IPs).
# After adding vars, redeploy.

