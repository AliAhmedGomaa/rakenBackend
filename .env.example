# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE_NAME

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Public scan page (Angular). May be origin only — /c/<carId> is appended.
# Example: http://172.20.10.2:4200  or  https://raken.app/c
PUBLIC_QR_BASE_URL=http://localhost:4200

# Optional
PORT=3000
